              <item>
               <widget class="QWidget" name="rowSettings_2" native="true">
                <layout class="QHBoxLayout" name="horizontalLayout_33">
                 <property name="topMargin">
                  <number>9</number>
                 </property>
                 <property name="bottomMargin">
                  <number>0</number>
                 </property>
                 <item>
                  <widget class="QComboBox" name="cbEmbedMethod">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Steganography Method:&lt;br/&gt;&lt;/span&gt;Choose the technique used to embed your data.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;LSB (Pixel Manipulation):&lt;br/&gt;&lt;/span&gt;Uses the Least Significant Bit to hide data inside the pixels themselves.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Metadata (Header Injection):&lt;br/&gt;&lt;/span&gt;Hides text in the file attribute &amp;quot;Description&amp;quot; (EXIF tag).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="sizeAdjustPolicy">
                    <enum>QComboBox::SizeAdjustPolicy::AdjustToContents</enum>
                   </property>
                   <property name="iconSize">
                    <size>
                     <width>16</width>
                     <height>16</height>
                    </size>
                   </property>
                   <item>
                    <property name="text">
                     <string>LSB (Pixel Manipulation)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Metadata (Header Injection)</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item>
                  <spacer name="horizontalSpacer_4">
                   <property name="orientation">
                    <enum>Qt::Orientation::Horizontal</enum>
                   </property>
                   <property name="sizeHint" stdset="0">
                    <size>
                     <width>40</width>
                     <height>20</height>
                    </size>
                   </property>
                  </spacer>
                 </item>
                </layout>
               </widget>
              </item>
              <item>
               <widget class="QWidget" name="rowSettings" native="true">
                <layout class="QHBoxLayout" name="horizontalLayout_32">
                 <property name="topMargin">
                  <number>3</number>
                 </property>
                 <item>
                  <widget class="QComboBox" name="cbInputFormat">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Input Interpretation:&lt;/span&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;&lt;br/&gt;&lt;/span&gt;Determines how the text in the message box is converted to bytes before embedding.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;UTF-8&lt;/span&gt;: &lt;br/&gt;Use for standard text messages. The text is hidden exactly as written.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Base64 / Hex&lt;/span&gt;:&lt;br/&gt;Use if your input is already an encoded string (e.g., a file or key). The app will decode this string into raw binary data before hiding it.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="currentText">
                    <string>UTF-8</string>
                   </property>
                   <item>
                    <property name="text">
                     <string>UTF-8</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Base64</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Hex</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item>
                  <widget class="QComboBox" name="cbChannel">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Target Channel:&lt;br/&gt;&lt;/span&gt;Selects which color channel(s) will carry the hidden data.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;RGB (All Channels):&lt;br/&gt;&lt;/span&gt;Maximum capacity. Hides data in Red, Green, and Blue pixels.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Blue Channel Only: &lt;br/&gt;&lt;/span&gt;Best stealth. The human eye is least sensitive to changes in blue, making the steganography harder to detect visually. But reduces capacity by 66%.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Red / Green Channel Only: &lt;br/&gt;&lt;/span&gt;Hides data exclusively in that specific color channel. &lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <item>
                    <property name="text">
                     <string>RGB (All Channels)</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Red Channel Only</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Green Channel Only</string>
                    </property>
                   </item>
                   <item>
                    <property name="text">
                     <string>Blue Channel Only</string>
                    </property>
                   </item>
                  </widget>
                 </item>
                 <item>
                  <widget class="QCheckBox" name="chkCompress">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Compress Data (Zlib):&lt;br/&gt;&lt;/span&gt;Reduces the size of your payload using zlib compression (level=9) before embedding. This allows you to hide larger amounts of data within the same cover image, though it may slightly increase processing time.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="text">
                    <string>Compress Data (Zlib)</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QCheckBox" name="chkCleanMetadata">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Remove Image Metadata (EXIF):&lt;br/&gt;&lt;/span&gt;Strips all existing metadata (such as GPS coordinates, camera model, and timestamps) from the cover image. Use this to ensure maximum privacy and anonymity for the resulting image.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="text">
                    <string>Remove Image Metadata (EXIF)</string>
                   </property>
                   <property name="checked">
                    <bool>true</bool>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <spacer name="horizontalSpacer_2">
                   <property name="orientation">
                    <enum>Qt::Orientation::Horizontal</enum>
                   </property>
                   <property name="sizeHint" stdset="0">
                    <size>
                     <width>150</width>
                     <height>20</height>
                    </size>
                   </property>
                  </spacer>
                 </item>
                 <item>
                  <widget class="QLineEdit" name="leEmbedSeed">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Custom Secret / Seed:&lt;br/&gt;&lt;/span&gt;Initializes the pseudo-random number generator for non-sequential pixel selection.&lt;br/&gt;This scatters your message randomly across the image pixels instead of filling them linearly, making the hidden data significantly harder to detect.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="placeholderText">
                    <string>Enter Secret / Seed</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QLineEdit" name="leEmbedCustomDelimiter">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Custom Delimiter:&lt;br/&gt;&lt;/span&gt;Defines a custom string appended to your data to mark its end. This acts as a stop-signal for the receiver to prevent reading random data after the actual message.&lt;br/&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Default&lt;/span&gt;: The system calculates the hidden message length and stores it within the first 32 bits of the image. &lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="placeholderText">
                    <string>Enter a Custom Delimiter</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
