      <widget class="QWidget" name="tabCryptography">
       <attribute name="title">
        <string>Cryptography</string>
       </attribute>
       <layout class="QVBoxLayout" name="verticalLayout_10">
        <item>
         <widget class="QGroupBox" name="gbEncrypt">
          <property name="title">
           <string>Encrypt</string>
          </property>
          <layout class="QVBoxLayout" name="verticalLayout_9">
           <item>
            <widget class="QWidget" name="colChooseEncryptMode" native="true">
             <layout class="QHBoxLayout" name="horizontalLayout_39">
              <item>
               <widget class="QRadioButton" name="rbModeSym">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Symmetric Encryption:&lt;br/&gt;&lt;/span&gt;Uses a single secret key to both lock (encrypt) and unlock (decrypt) your data. It is highly efficient and ideal for securing personal files where you are the only one holding the key.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="text">
                 <string>Symmetric (AES / ChaCha20)</string>
                </property>
                <property name="checked">
                 <bool>true</bool>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QRadioButton" name="rbModeAsym">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Hybrid Encryption (ECC + AES):&lt;br/&gt;&lt;/span&gt;Combines the security of Elliptic Curves with the speed of AES. It uses a recipient's &lt;b&gt;Public Key&lt;/b&gt; to safely transport a temporary secret key, which then encrypts the actual file. This allows for secure file sharing without needing to exchange a password beforehand.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="text">
                 <string>Hybrid (ECC + AES)</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QWidget" name="rowChooseFileToEncrypt" native="true">
             <layout class="QHBoxLayout" name="horizontalLayout_17">
              <item>
               <widget class="QLabel" name="lblChooseFileToEncrypt">
                <property name="text">
                 <string>File to Encrypt:</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QLineEdit" name="leChooseFileToEncrypt">
                <property name="readOnly">
                 <bool>true</bool>
                </property>
                <property name="placeholderText">
                 <string>Select a File</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="btnChooseFileToEncrypt">
                <property name="text">
                 <string>Browse</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QWidget" name="rowChooseEncAlgorithm" native="true">
             <layout class="QHBoxLayout" name="horizontalLayout_18">
              <item>
               <widget class="QLabel" name="lblChooseAlgorithm">
                <property name="text">
                 <string>Choose Algorithm:</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QComboBox" name="cbChooseEncAlgorithm">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Algorithm Selection:&lt;br/&gt;&lt;/span&gt;Choose the mathematical method for encryption.&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;AES-GCM:&lt;/span&gt; Recommended. High security with built-in tamper detection (Authenticated Encryption).&lt;br/&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;ChaCha20-Poly1305:&lt;/span&gt; A modern, fast alternative to AES.&lt;br/&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;AES-CBC / CFB / OFB:&lt;/span&gt; Classic modes that require padding to process data blocks.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QWidget" name="rowChooseEncKey" native="true">
             <layout class="QHBoxLayout" name="horizontalLayout_16">
              <item>
               <widget class="QLabel" name="lblChooseEncKey">
                <property name="text">
                 <string>Choose Key:</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QComboBox" name="cbChooseEncKey">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Key Selection:&lt;br/&gt;&lt;/span&gt;Select a compatible key from your Vault. For Symmetric mode, use an AES secret key. For Hybrid mode, you must select the &lt;b&gt;Public Key&lt;/b&gt; belonging to the intended recipient.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QWidget" name="rowEncryptAction" native="true">
             <layout class="QHBoxLayout" name="horizontalLayout_19">
              <item>
               <spacer name="spcEncryptLeft">
                <property name="orientation">
                 <enum>Qt::Orientation::Vertical</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>40</width>
                  <height>20</height>
                 </size>
                </property>
               </spacer>
              </item>
              <item>
               <widget class="QPushButton" name="btnEncrypt">
                <property name="text">
                 <string>Encrypt</string>
                </property>
               </widget>
              </item>
              <item>
               <spacer name="spcEncryptRight">
                <property name="orientation">
                 <enum>Qt::Orientation::Vertical</enum>
                </property>
                <property name="sizeHint" stdset="0">
                 <size>
                  <width>40</width>
                  <height>20</height>
                 </size>
                </property>
               </spacer>
              </item>
             </layout>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="gbDecrypt">
          <property name="title">
           <string>Decrypt</string>
          </property>
          <layout class="QVBoxLayout" name="verticalLayout_8">
           <item>
            <widget class="QWidget" name="colChooseDecryptMode" native="true">
             <layout class="QHBoxLayout" name="horizontalLayout_40">
