                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QWidget" name="rowChooseFileToDecrypt" native="true">
             <layout class="QHBoxLayout" name="horizontalLayout_14">
              <item>
               <widget class="QLabel" name="lblChooseFileToDecrypt">
                <property name="text">
                 <string>File to Decrypt:</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QLineEdit" name="leChooseFileToDecrypt">
                <property name="readOnly">
                 <bool>true</bool>
                </property>
                <property name="placeholderText">
                 <string>Select a File</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="btnChooseFileToDecrypt">
                <property name="text">
                 <string>Browse</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QWidget" name="rowChooseDecAlgorithm" native="true">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Decryption Algorithm:&lt;br/&gt;&lt;/span&gt;&lt;b&gt;CRITICAL:&lt;/b&gt; You must select the identical algorithm used for encryption. While modes like AES-GCM will warn you if the selection is wrong, legacy modes like CBC will produce a corrupted file without warning if mismatched.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <layout class="QHBoxLayout" name="horizontalLayout_20">
              <item>
               <widget class="QLabel" name="lblChooseDecAlgorithm">
                <property name="text">
                 <string>Choose Algorithm:</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QComboBox" name="cbChooseDecAlgorithm">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Decryption Algorithm:&lt;br/&gt;&lt;/span&gt;You must select the &lt;b&gt;exact same&lt;/b&gt; algorithm and mode used when the file was encrypted. If the algorithm or mode (like GCM vs. CBC) does not match, the decryption will fail to protect your data.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QWidget" name="rowChooseDecKey" native="true">
             <layout class="QHBoxLayout" name="horizontalLayout_21">
              <item>
               <widget class="QLabel" name="lblChooseDecKey">
                <property name="text">
                 <string>Choose Key:</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QComboBox" name="cbChooseDecKey">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline;&quot;&gt;Decryption Key:&lt;br/&gt;&lt;/span&gt;Select the key required to unlock the file. In Hybrid mode, this must be your own &lt;b&gt;Private Key&lt;/b&gt; that matches the Public Key the sender used to encrypt the file.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QWidget" name="rowDecryptAction" native="true">
             <layout class="QHBoxLayout" name="horizontalLayout_15">
              <item>
               <spacer name="spcDecryptLeft">
                <property name="orientation">
